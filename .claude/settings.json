{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.tfstate)",
      "Read(*.tfstate.*)",
      "Read(*.tfvars)",
      "Read(*.pem)",
      "Read(*.key)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(aws *)",
      "Bash(* ~/.ssh*)",
      "Bash(* ~/.aws*)",
      "Bash(* $HOME/.ssh*)",
      "Bash(* $HOME/.aws*)"
    ]
  }
}